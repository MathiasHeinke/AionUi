{
  "name": "command-eve",
  "version": "1.823.0",
  "description": "Command EVE local operator shell for Company.OS.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "FYN Labs LLC",
    "email": "admin@fyn-labs.com"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start:multi": "cross-env AIONUI_MULTI_INSTANCE=1 electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "cli": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "webui": "tsx scripts/webui.ts",
    "webui:remote": "tsx scripts/webui.ts --remote",
    "webui:prod": "cross-env NODE_ENV=production tsx scripts/webui.ts",
    "webui:prod:remote": "cross-env NODE_ENV=production tsx scripts/webui.ts --remote",
    "resetpass": "tsx scripts/resetpass.ts",
    "package": "electron-vite build --config packages/desktop/electron.vite.config.ts",
    "make": "electron-vite build --config packages/desktop/electron.vite.config.ts",
    "dist": "node scripts/build-with-builder.js",
    "dist:mac": "node scripts/build-with-builder.js auto --mac",
    "dist:win": "node scripts/build-with-builder.js auto --win",
    "dist:linux": "node scripts/build-with-builder.js auto --linux",
    "build-mac": "node scripts/build-with-builder.js arm64 --mac --arm64",
    "build-win": "node scripts/build-with-builder.js auto --win",
    "build-deb": "node scripts/build-with-builder.js auto --linux",
    "build-mac:arm64": "node scripts/build-with-builder.js arm64 --mac --arm64",
    "build-mac:x64": "node scripts/build-with-builder.js x64 --mac --x64",
    "build-win:arm64": "node scripts/build-with-builder.js arm64 --win --arm64",
    "build-win:x64": "node scripts/build-with-builder.js x64 --win --x64",
    "build": "node scripts/build-with-builder.js arm64 --mac --arm64",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "brand:icons": "node scripts/generate-command-eve-icons.mjs",
    "brand:verify": "node scripts/verify-command-eve-brand-assets.mjs",
    "security:audit:production": "node scripts/security/production-audit-gate.mjs",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:gate-null": "vitest run tests/unit/command-eve/gateNull*.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:packaged:i18n": "vitest run tests/integration/i18n-packaged.test.ts",
    "test:release:gates": "node --test scripts/release/*.test.mjs scripts/fetch-bundled-skills.test.mjs",
    "release:verify:first-run": "node scripts/release/verify-command-eve-first-run-bundle.mjs",
    "bench": "vitest bench",
    "bench:db": "bun test ./tests/bench/database.bench.bun.ts",
    "bench:report": "bunx tsx scripts/run-benchmarks.ts",
    "bench:startup": "bunx tsx scripts/benchmark-startup.ts",
    "bench:startup:packaged": "bunx tsx scripts/benchmark-startup.ts --packaged --warmup 1 --with-memory --strict",
    "bench:full": "bunx tsx scripts/run-benchmarks.ts --startup",
    "debug:perf": "cross-env ACP_PERF=1 PERF_MONITOR=1 bun start",
    "debug:perf:report": "bun run bench:full",
    "debug:mcp": "bunx tsx scripts/debug-mcp.ts",
    "debug:mcp:list": "bunx tsx scripts/debug-mcp.ts list",
    "debug:mcp:validate": "bunx tsx scripts/debug-mcp.ts validate",
    "debug:custom-agent": "bunx tsx scripts/debug-custom-agent.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:baseline": "node scripts/e2e-baseline-diff.mjs --run-playwright",
    "test:e2e:team": "playwright test --config playwright.config.ts tests/e2e/cases/teams/*.e2e.ts --reporter=list",
    "test:e2e:team:create": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-create.e2e.ts --reporter=list",
    "test:e2e:team:lifecycle": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-agent-lifecycle.e2e.ts --reporter=list",
    "test:e2e:team:whitelist": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-whitelist.e2e.ts --reporter=list",
    "test:e2e:team:comm": "playwright test --config playwright.config.ts tests/e2e/cases/teams/team-communication.e2e.ts --reporter=list",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "test:bun": "bun test ./packages/desktop/src/process/services/database/drivers --pass-with-no-tests",
    "build-mac:notarized": "cross-env NOTARYTOOL_KEYCHAIN_PROFILE=command-eve-notary APPLE_DMG_SIGN_IDENTITY=\"Developer ID Application: FYN Labs LLC (NHNQ7Q5H28)\" node scripts/build-with-builder.js arm64 --mac --arm64",
    "build-mac:arm64:notarized": "cross-env NOTARYTOOL_KEYCHAIN_PROFILE=command-eve-notary APPLE_DMG_SIGN_IDENTITY=\"Developer ID Application: FYN Labs LLC (NHNQ7Q5H28)\" node scripts/build-with-builder.js arm64 --mac --arm64",
    "command-eve:bench:models": "tsx scripts/command-eve-model-latency-benchmark.ts",
    "command-eve:bench:ttft": "tsx scripts/command-eve/ttft/benchmark.ts",
    "command-eve:bench:ttft:typecheck": "tsc -p scripts/command-eve/ttft/tsconfig.json",
    "command-eve:package:e2e-attachment": "cross-env COMMAND_EVE_E2E_PACKAGED_BUILD=1 node scripts/build-with-builder.js arm64 --mac --arm64 --dir",
    "command-eve:test:native-voice:e2e": "cross-env RUN_COMMAND_EVE_NATIVE_VOICE_E2E=1 playwright test --config playwright.config.ts tests/e2e/specs/command-eve-native-voice-dialogue.e2e.ts --reporter=list --workers=1 --retries=0",
    "command-eve:pilot:bonsai": "tsx scripts/command-eve-bonsai-pilot.ts",
    "command-eve:pilot:bonsai:hermes": "tsx scripts/command-eve-bonsai-hermes-eval.ts",
    "command-eve:smoke:gemma-title": "tsx scripts/command-eve-gemma-title-smoke-gate.ts",
    "command-eve:smoke:cloud-tts": "node scripts/command-eve-tts-electron-smoke-launcher.mjs"
  },
